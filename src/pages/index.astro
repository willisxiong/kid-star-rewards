---
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { localeFromCookieHeader, text } from '../lib/i18n';
import Base from '../layouts/Base.astro';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const locale = localeFromCookieHeader(Astro.request.headers.get('cookie'));
const copy = text(locale);
---
<Base title={copy.productName} locale={locale}>
  <div class="index-wrap">
    <div class="header-row">
      <h1>{copy.productName}</h1>
      <LanguageSwitch locale={locale} />
    </div>
    <p class="sub">{copy.indexIntro}</p>
    <div class="entry-row">
      <a class="entry-card" href="/kid">
        <span class="tag">/kid</span>
        <div class="name">{copy.kidEntry}</div>
        <div class="note">{copy.kidEntryNote}</div>
      </a>
      <a class="entry-card parent" href="/parent">
        <span class="tag">/parent</span>
        <div class="name">{copy.parentEntry}</div>
        <div class="note">{copy.parentEntryNote}</div>
      </a>
    </div>
  </div>
</Base>
