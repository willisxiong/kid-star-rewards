---
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { localeFromCookieHeader, text } from '../lib/i18n';
import Base from '../layouts/Base.astro';
import type { KidState } from '../lib/types';
import { kidState } from '../server/data';
import { resolveSessions } from '../server/sessions';

const locale = localeFromCookieHeader(Astro.request.headers.get('cookie'));
const copy = text(locale);

Astro.response.headers.set('Cache-Control', 'private, no-store');

const boot = await loadKidBoot();
const initialKidJson = JSON.stringify(boot.state).replace(/</g, '\\u003c');

async function loadKidBoot(): Promise<{ state: KidState | null; showGate: boolean }> {
  try {
    const env = Astro.locals.runtime?.env;
    if (!env?.DB) return { state: null, showGate: false };
    const secret = env.SESSION_SECRET ?? '';
    if (secret.length < 16) return { state: null, showGate: false };
    const resolved = await resolveSessions(env.DB, secret, Astro.request.headers.get('cookie') ?? undefined, Astro.request.url);
    for (const cookie of resolved.setCookies) Astro.response.headers.append('Set-Cookie', cookie);
    const session = resolved.child;
    if (!session || !session.child_id) return { state: null, showGate: true };
    return { state: await kidState(env.DB, session.family_id, session.child_id), showGate: false };
  } catch (error) {
    console.error('[kid-star] kid bootstrap', error);
    return { state: null, showGate: false };
  }
}
---
<Base title={copy.kidTitle} locale={locale}>
  <p class="boot-note" id="boot" hidden={boot.showGate || Boolean(boot.state)}>{copy.loading}</p>
  <div class="widget-container" id="gate" hidden={!boot.showGate}>
    <div class="app-card">
      <div class="header-row">
        <div class="app-title-group">
          <span class="material-symbols-outlined app-title-icon">auto_awesome</span>
          <h2 class="app-title">{copy.productName}</h2>
        </div>
        <div class="header-tools">
          <LanguageSwitch locale={locale} />
          <span class="route-chip">/kid</span>
        </div>
      </div>
      <p class="auth-note" id="gate-note">{copy.gateNote}</p>
      <form id="code-form" class="auth-stack" method="post" action="/api/auth/child">
        <input id="family-code-input" class="lumi-input-custom" name="familyCode" autocomplete="off" placeholder={copy.familyCodePlaceholder} />
        <div class="auth-actions">
          <button class="action-btn primary" type="submit">{copy.bindDevice}</button>
          <a class="text-link" href="/parent">{copy.imParent}</a>
        </div>
      </form>
    </div>
  </div>
  <div class="widget-container" id="app" hidden={!boot.state}>
    <div class="app-card">
      <div class="header-row">
        <div class="app-title-group">
          <span class="material-symbols-outlined app-title-icon">auto_awesome</span>
          <h2 class="app-title">{copy.productName}</h2>
        </div>
        <div class="header-tools">
          <LanguageSwitch locale={locale} />
          <span class="route-chip">/kid</span>
        </div>
      </div>
      <div class="meta-row">
        <span class="route-chip" id="child-name">{boot.state?.childName ?? copy.childFallback}</span>
        <button class="action-btn small" type="button" id="logout">{copy.signOutDevice}</button>
      </div>
      <div class="hero-banner">
        <div>
          <div class="balance-label">
            <span class="material-symbols-outlined fill" style="font-size: 16px; color: #f59e0b;">stars</span> {copy.starsAvailable}
          </div>
          <div class="balance-num">
            <span id="balance">{boot.state?.balance ?? 0}</span>
            <span class="balance-unit">{copy.starUnit}</span>
          </div>
        </div>
        <span class="material-symbols-outlined star-hero-icon">star</span>
      </div>
      <div class="view-col">
        <div class="section">
          <div class="section-title">
            <span class="material-symbols-outlined" style="color: #3186ff;">task_alt</span> {copy.dailyTasks}
          </div>
          <div class="grid-cards" id="task-grid"></div>
        </div>
        <div class="section" id="burst-section" hidden>
          <div class="section-title">
            <span class="material-symbols-outlined" style="color: #f59e0b;">auto_awesome</span> {copy.taskKindBurst}
          </div>
          <div class="grid-cards" id="burst-grid"></div>
        </div>
        <div class="section">
          <div class="section-title">
            <span class="material-symbols-outlined" style="color: #f59e0b;">redeem</span> {copy.wishlist}
          </div>
          <div class="grid-cards" id="reward-grid"></div>
        </div>
      </div>
    </div>
  </div>
  <script id="kid-bootstrap" type="application/json" is:inline set:html={initialKidJson}></script>
  <script>
    import { bootKid } from '../scripts/kid';
    import type { KidState } from '../lib/types';

    const raw = document.getElementById('kid-bootstrap')?.textContent;
    let initial: KidState | null = null;
    if (raw && raw !== 'null') {
      try {
        initial = JSON.parse(raw) as KidState;
      } catch {
        initial = null;
      }
    }
    bootKid(initial);
  </script>
</Base>
