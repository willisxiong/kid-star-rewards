---
import Base from '../layouts/Base.astro';
---
<Base title="/kid · 儿童星级奖励系统">
  <p class="boot-note" id="boot">正在加载…</p>
  <div class="widget-container" id="gate" hidden>
    <div class="app-card">
      <div class="header-row">
        <div class="app-title-group">
          <span class="material-symbols-outlined app-title-icon">auto_awesome</span>
          <h2 class="app-title">儿童星级奖励系统</h2>
        </div>
        <span class="route-chip">/kid</span>
      </div>
      <p class="auth-note" id="gate-note">输入家庭码，把这台设备绑定到家庭。同一个家庭码可以绑定多台设备。</p>
      <form id="code-form" class="auth-stack">
        <input id="family-code-input" class="lumi-input-custom" name="familyCode" autocomplete="off" placeholder="家庭码 (例: STAR-4821)" />
        <div class="auth-actions">
          <button class="action-btn primary" type="submit">绑定这台设备</button>
          <a class="text-link" href="/parent">我是家长</a>
        </div>
      </form>
    </div>
  </div>
  <div class="widget-container" id="app" hidden>
    <div class="app-card">
      <div class="header-row">
        <div class="app-title-group">
          <span class="material-symbols-outlined app-title-icon">auto_awesome</span>
          <h2 class="app-title">儿童星级奖励系统</h2>
        </div>
        <span class="route-chip">/kid</span>
      </div>
      <div class="meta-row">
        <span class="route-chip" id="child-name">儿童</span>
        <button class="action-btn small" type="button" id="logout">退出此设备</button>
      </div>
      <div class="hero-banner">
        <div>
          <div class="balance-label">
            <span class="material-symbols-outlined fill" style="font-size: 16px; color: #f59e0b;">stars</span> 当前可用积分
          </div>
          <div class="balance-num">
            <span id="balance">0</span>
            <span class="balance-unit">星</span>
          </div>
        </div>
        <span class="material-symbols-outlined star-hero-icon">star</span>
      </div>
      <div class="view-col">
        <div class="section">
          <div class="section-title">
            <span class="material-symbols-outlined" style="color: #3186ff;">task_alt</span> 每日打卡任务
          </div>
          <div class="grid-cards" id="task-grid"></div>
        </div>
        <div class="section">
          <div class="section-title">
            <span class="material-symbols-outlined" style="color: #f59e0b;">redeem</span> 奖励心愿单
          </div>
          <div class="grid-cards" id="reward-grid"></div>
        </div>
      </div>
    </div>
  </div>
</Base>
<script>
  import { bootKid } from '../scripts/kid';
  bootKid();
</script>
