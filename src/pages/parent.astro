---
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { localeFromCookieHeader, text } from '../lib/i18n';
import Base from '../layouts/Base.astro';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const locale = localeFromCookieHeader(Astro.request.headers.get('cookie'));
const copy = text(locale);
---
<Base title={copy.parentTitle} locale={locale}>
  <p class="boot-note" id="boot">{copy.loading}</p>
  <div class="widget-container" id="gate" hidden>
    <div class="app-card">
      <div class="header-row">
        <div class="app-title-group">
          <span class="material-symbols-outlined app-title-icon">auto_awesome</span>
          <h2 class="app-title">{copy.productName}</h2>
        </div>
        <div class="header-tools">
          <LanguageSwitch locale={locale} />
          <span class="route-chip">/parent</span>
        </div>
      </div>
      <p class="auth-note" id="login-help">{copy.loginHelp}</p>
      <form id="email-form" class="auth-stack">
        <input id="email" class="lumi-input-custom" type="email" name="email" autocomplete="email" placeholder={copy.emailPlaceholder} />
        <div class="auth-actions">
          <button class="action-btn primary" type="button" id="passkey-login">{copy.usePasskey}</button>
          <button class="action-btn" type="submit" id="send-link">{copy.sendLink}</button>
          <a class="text-link" href="/kid">{copy.imChild}</a>
        </div>
      </form>
      <p class="auth-note" id="passkey-unsupported" hidden>{copy.passkeyUnsupported}</p>
      <p class="auth-note" id="sent-note" hidden></p>
      <div class="dev-link" id="dev-link" hidden></div>
    </div>
  </div>
  <div class="widget-container" id="enroll" hidden>
    <div class="app-card">
      <div class="header-row">
        <div class="app-title-group">
          <span class="material-symbols-outlined app-title-icon">auto_awesome</span>
          <h2 class="app-title">{copy.enrollTitle}</h2>
        </div>
        <div class="header-tools">
          <LanguageSwitch locale={locale} />
          <span class="route-chip">/parent</span>
        </div>
      </div>
      <p class="auth-warn">{copy.enrollWarn}</p>
      <p class="auth-note">{copy.enrollNote}</p>
      <div class="auth-actions">
        <button class="action-btn primary" type="button" id="enroll-passkey">{copy.enrollButton}</button>
        <button class="action-btn" type="button" id="enroll-logout">{copy.signOut}</button>
      </div>
    </div>
  </div>
  <div class="widget-container" id="app" hidden>
    <div class="app-card">
      <div class="header-row">
        <div class="app-title-group">
          <span class="material-symbols-outlined app-title-icon">auto_awesome</span>
          <h2 class="app-title">{copy.productName}</h2>
        </div>
        <div class="header-tools">
          <LanguageSwitch locale={locale} />
          <span class="route-chip">/parent</span>
        </div>
      </div>
      <div class="meta-row">
        <div class="meta-left">
          <span class="route-chip" id="family-code">{copy.familyCode('')}</span>
          <label class="tz-label">{copy.timezoneLabel}
            <select id="timezone" class="lumi-input-custom tz-select"></select>
          </label>
        </div>
        <div class="auth-actions">
          <button class="action-btn small" type="button" id="manage-keys">{copy.keysAndSignIn}</button>
          <button class="action-btn small" type="button" id="logout">{copy.signOut}</button>
        </div>
      </div>
      <div id="keys-panel" class="keys-panel" hidden>
        <div class="section-title">
          <span class="material-symbols-outlined">passkey</span> {copy.keysAndSignIn}
        </div>
        <p class="auth-warn">{copy.keysWarn}</p>
        <div class="catalog-list" id="keys-list"></div>
        <div class="auth-actions">
          <button class="action-btn primary" type="button" id="register-another">{copy.registerAnother}</button>
        </div>
      </div>
      <div class="hero-banner">
        <div>
          <div class="balance-label">
            <span class="material-symbols-outlined fill" style="font-size: 16px; color: #f59e0b;">stars</span> {copy.starsAvailable}
          </div>
          <div class="balance-num">
            <span id="balance">0</span>
            <span class="balance-unit">{copy.starUnit}</span>
          </div>
        </div>
        <span class="material-symbols-outlined star-hero-icon">star</span>
      </div>
      <div class="view-col">
        <div class="section">
          <div class="section-title">
            <span class="material-symbols-outlined" style="color: #de2d29;">pending_actions</span>
            {copy.pendingTitle} <span class="badge-count" id="pending-badge" hidden>0</span>
          </div>
          <div class="pending-list" id="pending-list"></div>
        </div>
        <div class="section">
          <div class="section-title">
            <span class="material-symbols-outlined" style="color: #3186ff;">add_task</span> {copy.addTaskSection}
          </div>
          <p class="auth-note task-form-note">{copy.taskFormNote}</p>
          <div class="form-row task-kind-row">
            <label class="labeled-field">
              <span>{copy.taskKindLabel}</span>
              <select id="task-kind" class="lumi-input-custom">
                <option value="daily">{copy.taskKindDaily}</option>
                <option value="starburst">{copy.taskKindBurst}</option>
              </select>
            </label>
            <label class="labeled-field" id="task-limit-field">
              <span>{copy.dailyLimitLabel}</span>
              <input id="task-daily-limit" class="lumi-input-custom" type="number" inputmode="numeric" min="1" max="9" step="1" value="1" />
            </label>
          </div>
          <div class="form-row">
            <input type="text" id="task-name" class="lumi-input-custom" placeholder={copy.taskNamePlaceholder} />
            <input type="number" id="task-points" class="lumi-input-custom" placeholder={copy.taskPointsPlaceholder} min="1" max="999" />
            <button class="action-btn primary" type="button" id="add-task">{copy.addTask}</button>
          </div>
          <div class="catalog-list" id="task-catalog"></div>
        </div>
        <div class="section">
          <div class="section-title">
            <span class="material-symbols-outlined" style="color: #f59e0b;">add_shopping_cart</span> {copy.addRewardSection}
          </div>
          <div class="form-row">
            <input type="text" id="reward-name" class="lumi-input-custom" placeholder={copy.rewardNamePlaceholder} />
            <input type="number" id="reward-cost" class="lumi-input-custom" placeholder={copy.rewardCostPlaceholder} min="1" />
            <button class="action-btn primary" type="button" id="add-reward">{copy.addReward}</button>
          </div>
          <div class="catalog-list" id="reward-catalog"></div>
        </div>
        <div class="section">
          <div class="section-title">
            <span class="material-symbols-outlined">history</span> {copy.logSection}
          </div>
          <div class="log-list" id="log-list"></div>
        </div>
      </div>
    </div>
  </div>
</Base>
<script>
  import { bootParent } from '../scripts/parent';
  bootParent();
</script>
